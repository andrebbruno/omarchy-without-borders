# Maintainer: Andre Bruno
pkgname=omarchy-without-borders
pkgver=0.1.0
pkgrel=1
pkgdesc="Mouse Without Borders (PowerToys) client for Linux/Wayland — share mouse, keyboard and clipboard with Windows"
arch=('any')
url="https://github.com/andrebbruno/omarchy-without-borders"
license=('MIT')
depends=('python' 'python-pywayland' 'python-cryptography' 'python-xkbcommon' 'libei' 'wl-clipboard' 'hyprland' 'libnotify')
optdepends=('gum: assistente de configuração interativo' 'ufw: liberação automática da porta')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 systemd/owb.service "$pkgdir/usr/lib/systemd/user/owb.service"
  install -Dm644 systemd/owb.socket "$pkgdir/usr/lib/systemd/user/owb.socket"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
