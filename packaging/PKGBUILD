# Maintainer: Andre Bruno
pkgname=omarchy-without-borders
pkgver=0.2.1
pkgrel=1
pkgdesc="Mouse Without Borders (PowerToys) client for Linux/Wayland — share mouse, keyboard and clipboard with Windows"
arch=('any')
url="https://github.com/andrebbruno/omarchy-without-borders"
license=('MIT')
depends=('python' 'python-cryptography' 'libei' 'libnotify')
optdepends=('python-pywayland: Hyprland backend' 'python-xkbcommon: Hyprland backend' 'wl-clipboard: Hyprland backend clipboard'
            'python-gobject: portal backend (GNOME, KDE)' 'gum: interactive setup wizard' 'ufw: open the ports automatically')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('6eb2601f3da78e5f6929a49588d18b89968877b1d0e6a6de29f7e54e582bd2d0')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 systemd/owb.service "$pkgdir/usr/lib/systemd/user/owb.service"
  install -Dm644 systemd/owb.socket "$pkgdir/usr/lib/systemd/user/owb.socket"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
